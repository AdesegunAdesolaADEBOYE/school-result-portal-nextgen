# Copy this file to .env and fill in real values. Never commit .env.

# Full Postgres connection string.
# Local example:   postgres://postgres:postgres@localhost:5432/result_portal
# Render/Railway/Neon give you this string directly on the database's page.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/result_portal

# Set to "true" only if your Postgres host requires SSL (Render, Railway, Neon, Supabase all do).
DATABASE_SSL=false

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL).
CLIENT_ORIGIN=http://localhost:5173

# Credentials for the first admin account, created by `npm run seed`.
SEED_ADMIN_EMAIL=admin@school.edu.ng
SEED_ADMIN_PASSWORD=Admin@12345
